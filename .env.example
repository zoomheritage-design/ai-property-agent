# ---- Supabase (required) ----
# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Optional: secrets pre-fill for the in-app Settings page ----
# (Everything below can instead be entered in the app's /settings screen,
#  where it is stored securely inside Supabase and used by the scan job.)
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
OPENAI_API_KEY=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
